# ==============================================================================
# Brainnote SaaS — Environment Configuration Template (.env.example)
# IMPORTANT: DO NOT commit real secrets to source control.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Public Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Brainnote"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development" # development | staging | production

# ------------------------------------------------------------------------------
# 2. Database & Data Isolation (PostgreSQL / Supabase / Neon / AWS RDS)
# ------------------------------------------------------------------------------
# Connection string with pooler for serverless environments
DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres?sslmode=require"
# Direct database URL for running migrations
DIRECT_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# Supabase Auth & Row-Level Security (Optional if using Supabase directly)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-expose-to-client"

# ------------------------------------------------------------------------------
# 3. Authentication & Session Security (NextAuth / JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# ------------------------------------------------------------------------------
# 4. AI Provider APIs (SERVER-SIDE ONLY - NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Primary AI Provider: "gemini" | "openai" | "anthropic"
AI_PROVIDER="gemini"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# OpenAI API (for GPT-4o summaries and Whisper audio transcription)
OPENAI_API_KEY="your-openai-api-key"

# Anthropic Claude API (alternative model provider)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ------------------------------------------------------------------------------
# 5. Billing & Subscriptions (Stripe / LemonSqueezy)
# ------------------------------------------------------------------------------
# Server-side Stripe API keys
STRIPE_SECRET_KEY="sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Public Stripe Publishable Key (safe for client side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Stripe Recurring Price IDs (created in Stripe Dashboard)
STRIPE_PRICE_ID_PRO_MONTHLY="price_1xxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_ID_PRO_YEARLY="price_1xxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_ID_TEAM_MONTHLY="price_1xxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 6. Object Storage for Note Attachments (PDFs, Audio, Video)
# Compatible with AWS S3, Cloudflare R2, or Supabase Storage
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="s3" # s3 | r2 | supabase | local
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="brainnote-user-uploads"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# ------------------------------------------------------------------------------
# 7. Usage Limits & Free Trial Configuration
# ------------------------------------------------------------------------------
FREE_TRIAL_DAYS=7
FREE_TRIAL_AI_TOKENS_LIMIT=50000
PRO_MONTHLY_AI_TOKENS_LIMIT=1000000
TEAM_MONTHLY_AI_TOKENS_LIMIT=5000000
