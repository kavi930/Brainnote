# ==============================================================================
# Brainnote AI — Supabase Environment Configuration Template (.env.supabase.example)
# DO NOT COMMIT REAL SECRETS. Copy values from your Supabase Dashboard to .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Credentials
# Location in Supabase Dashboard:
# -> Open your project -> Click the gear icon (Project Settings) -> "API"
# ------------------------------------------------------------------------------

# Project URL: Found under "Project URL"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Anon Public API Key: Found under "Project API keys" -> "anon public"
# (Safe for browser client requests; enforces Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Service Role Secret API Key: Found under "Project API keys" -> "service_role secret"
# CRITICAL SECURITY RULE: NEVER prefix this with NEXT_PUBLIC_. Keep strictly server-side.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Connection Strings (For Serverless & Direct)
# Location in Supabase Dashboard:
# -> Open your project -> Click gear icon (Project Settings) -> "Database"
# -> Scroll to "Connection string" -> Select "URI" tab
# ------------------------------------------------------------------------------

# Recommended for Vercel Serverless: "Transaction mode" Pooler (Port 6543)
# Uses Supavisor connection pooler to prevent lambda socket exhaustion
DATABASE_URL="postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (Port 5432) for running migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[your-project-ref].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Application Public URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development" # Set to "production" on Vercel deployment
